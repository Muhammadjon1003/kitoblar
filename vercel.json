{
  "buildCommand": "prisma generate && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/backend/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/telegram-webhook",
      "destination": "/api/index.ts"
    },
    {
      "source": "/webhook-(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
